<Window x:Class="Rounder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rounder"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button Content="Open file" Click="OpenFile" Padding="5 2 5 2" Margin="3"/>
                <Button Content="Round off corners" Click="RoundOffCorners" Padding="5 2 5 2" Margin="3"/>
                <Button Content="Save modified copy" Click="SaveFile" Padding="5 2 5 2" Margin="3"/>
            </StackPanel>
            <DockPanel>
                <Image Source="{Binding Source={StaticResource ImgInput}}" DockPanel.Dock="Left" Width="100"/>
                <Image Source="{Binding Source={StaticResource ImgOutput}}" DockPanel.Dock="Right" Width="100"/>
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>